# Optional — enables AI simplification, summaries, quizzes and Q&A.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Offline Whisper model for the Recording mode: tiny | base | small | medium | large-v3 | turbo
WHISPER_MODEL=small

MAX_INPUT_CHARS=20000
MAX_PDF_PAGES=40
